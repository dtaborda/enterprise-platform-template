# ─────────────────────────────────────────────────────────────────────────────
# Enterprise Platform Template - Environment Variables
# ─────────────────────────────────────────────────────────────────────────────
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ─────────────────────────────────────────────────────────────────────────────
# Supabase
# ─────────────────────────────────────────────────────────────────────────────

# Public API URL — exposed to the browser (NEXT_PUBLIC_ prefix)
# Local dev: http://127.0.0.1:55331 (port set in supabase/config.toml → [api].port)
# Production: https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:55331

# Anonymous (public) key — safe to expose in the browser
# Local dev: deterministic key from `supabase start` (same for everyone)
# Production: get from Supabase Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6ImFub24iLCJleHAiOjE5ODM4MTI5OTZ9.CRXP1A7WOeoJeXxjNni43kdQwgnWNReilDMblYTn_I0

# Service role key — SECRET, server-side only, NEVER expose to the browser
# Local dev: deterministic key from `supabase start`
# Production: get from Supabase Dashboard → Project Settings → API
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6InNlcnZpY2Vfcm9sZSIsImV4cCI6MTk4MzgxMjk5Nn0.EGIM96RAZx35lJzdJsyH-qQwv8Hdp7fsn3W0YpN81IU

# Direct Postgres connection (local)
# Used by Drizzle Kit (studio, introspect) — NOT for runtime queries.
# Local dev port set in supabase/config.toml → [db].port
# Production: postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-1-us-west-2.pooler.supabase.com:6543/postgres
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:55332/postgres

# ─────────────────────────────────────────────────────────────────────────────
# Brand Configuration
# ─────────────────────────────────────────────────────────────────────────────

# Brand slug — forces a specific brand to be rendered regardless of subdomain
# or path prefix. Required for single-brand deployments and local development.
# Must match the `slug` field of a brand config in packages/brand/src/brands/.
# Example: BRAND_SLUG=enterprise
# Omit to enable subdomain-based or path-prefix-based brand resolution.
BRAND_SLUG=enterprise

# The app display name is NOT an environment variable. It comes from
# BrandConfig.displayName in packages/brand/src/brands/<slug>.brand.ts, which
# feeds brand-logo.tsx, brand-footer.tsx, and generateBrandMetadata().
# Do not reintroduce NEXT_PUBLIC_APP_NAME — no code reads it.

# ─────────────────────────────────────────────────────────────────────────────
# App Configuration
# ─────────────────────────────────────────────────────────────────────────────

# Base URL of the app — used for absolute URL generation (emails, redirects)
# Read through getAppUrl() in packages/core/src/utils/env.ts, which resolves
# NEXT_PUBLIC_APP_URL → NEXT_PUBLIC_SITE_URL → APP_URL in that order.
# In production, getAppUrl() throws when none of the three is set.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Escape hatch that allows a localhost-style canonical URL in production.
# Values: "true" to allow | anything else (including unset) to reject.
# When NODE_ENV=production, getAppUrl() rejects hostnames localhost, 127.0.0.1,
# 0.0.0.0, ::1, and *.localhost unless this is set to the exact string "true".
# It does NOT relax the separate requirement that a canonical URL be set at all —
# that check throws first, regardless of this flag.
# Only needed to run a production build against a local server (see
# playwright.config.ts). NEVER set this on a real deployment: it lets auth
# redirects and email links point at localhost.
# ALLOW_LOCALHOST_APP_URL_IN_PRODUCTION=true

# Environment name — used for logging and monitoring
# Values: development | test | production
NEXT_PUBLIC_APP_ENV=development

# ─────────────────────────────────────────────────────────────────────────────
# Email (Resend)
# ─────────────────────────────────────────────────────────────────────────────

# Resend API key (SECRET, server-side only)
# Get from: https://resend.com
# Present  → invitation and notification emails are sent through Resend.
# Absent   → both fall back to the console adapters, which log instead of send.
RESEND_API_KEY=

# From address used for all outgoing emails.
# REQUIRED whenever RESEND_API_KEY is set. There is deliberately no fallback:
# createInvitationEmailAdapter() and createNotificationEmailAdapter() both call
# getEmailFrom(), which THROWS when RESEND_API_KEY is set and EMAIL_FROM is not.
# Sending from an unverified domain is silently dropped or spam-filtered by the
# provider, so this fails loudly at adapter construction instead.
# Must be an address on a domain verified with your email provider.
EMAIL_FROM=noreply@yourdomain.com

# ─────────────────────────────────────────────────────────────────────────────
# Billing (Stripe)
# ─────────────────────────────────────────────────────────────────────────────
# Controls which adapter is selected by createPaymentAdapter() in
# packages/core/src/services/adapters/payment-adapter-factory.ts.

# Supported values: "stripe" (default when unset) | "local"
# Any other value throws at adapter construction.
#
# 🚨 DEPLOYMENTS WITHOUT BILLING MUST SET BILLING_PROVIDER=local EXPLICITLY.
# In production with BILLING_PROVIDER unset (or "stripe") and no
# STRIPE_SECRET_KEY, createPaymentAdapter() THROWS. Consequences:
#   - every billing Server Action fails
#   - new tenants silently get no subscription row — sign-up itself still
#     succeeds because onboarding catches and logs the failure
#
# Why the throw exists instead of a silent fallback to the local adapter:
# LocalPaymentAdapter.verifyWebhookSignature() performs NO signature
# verification — it accepts every payload unconditionally. The billing webhook
# route (ui/app/api/webhooks/billing/route.ts) is public and unauthenticated, so
# silently falling back to it in production would leave that route open to
# forged payloads. Opting out of billing must therefore be a deliberate choice.
BILLING_PROVIDER=local

# Stripe secret key (SECRET, server-side only)
# Get from: Stripe Dashboard → Developers → API keys
# REQUIRED when BILLING_PROVIDER is "stripe" (or unset) and NODE_ENV=production.
# Outside production its absence falls back to the local adapter with no error.
STRIPE_SECRET_KEY=

# Stripe webhook signing secret (SECRET, server-side only)
# Get from: Stripe Dashboard → Developers → Webhooks → your endpoint
# Used to verify inbound webhook signatures. Verification fails CLOSED: when
# this is empty, every request to the billing webhook route is rejected with
# HTTP 400. Stripe billing is not functional without it.
STRIPE_WEBHOOK_SECRET=

# ─────────────────────────────────────────────────────────────────────────────
# Sentry (error monitoring) - Optional
# ─────────────────────────────────────────────────────────────────────────────

# Sentry DSN — public, safe to expose in the browser
# Get from: Sentry Dashboard → Project → Settings → SDK Setup → DSN
# NEXT_PUBLIC_SENTRY_DSN=

# Sentry auth token — for source map upload during build (SECRET)
# Get from: https://sentry.io/settings/account/api/auth-tokens/
# SENTRY_AUTH_TOKEN=

# Sentry organization slug
# SENTRY_ORG=

# Sentry project slug
# SENTRY_PROJECT=

# Verbose Sentry SDK logging — read by ui/instrumentation-client.ts,
# ui/sentry.server.config.ts, and ui/sentry.edge.config.ts.
# Values: "true" to enable | anything else (including unset) to disable.
# Leave unset in production — debug output is noisy and adds no value there.
# SENTRY_DEBUG=true

# ─────────────────────────────────────────────────────────────────────────────
# Backend Provider Configuration
# ─────────────────────────────────────────────────────────────────────────────
# Controls which adapter is selected by createBackendAdapters() in
# packages/core/src/services/backend-adapters.ts.
# Both variables default to "supabase" when unset — no changes needed for the
# default Supabase path. Set to "custom" when wiring a custom adapter
# (e.g. Firebase, Clerk, or Auth0 for auth; S3 or Cloudflare R2 for storage).
#
# See docs/developer-guide/backend-provider-migration.md for the full guide.

# Supported values: "supabase" (default) | "custom"
# Set to "custom" to wire your own AuthPort implementation (e.g. Firebase, Clerk, Auth0).
# When "custom", update createBackendAdapters() to return your adapter instance.
BACKEND_AUTH_PROVIDER=supabase

# Supported values: "supabase" (default) | "custom"
# Set to "custom" to wire your own StoragePort implementation (e.g. S3, Cloudflare R2, local).
# When "custom", update createBackendAdapters() to return your adapter instance.
BACKEND_STORAGE_PROVIDER=supabase

# ─────────────────────────────────────────────────────────────────────────────
# E2E Testing (used by Playwright tests — credentials from supabase/seed.sql)
# ─────────────────────────────────────────────────────────────────────────────

E2E_EMAIL=admin@enterprise.dev
E2E_PASSWORD=password123

# ─────────────────────────────────────────────────────────────────────────────
# Vercel (auto-injected — do NOT set manually)
# ─────────────────────────────────────────────────────────────────────────────

# VERCEL_GIT_COMMIT_SHA=
# VERCEL_URL=
# VERCEL_ENV=